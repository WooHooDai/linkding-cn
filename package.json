{
  "name": "linkding-cn",
  "version": "1.2.1",
  "description": "Self-hosted bookmark manager - Chinese enhanced fork of linkding",
  "main": "index.js",
  "scripts": {
    "build": "npm run build-js && npm run build-adapters-js && npm run build-theme-light && npm run build-theme-dark && npm run build-defuddle && npm run build-site-adapters-css",
    "build-js": "rollup -c",
    "build-adapters-js": "node site_adapters/frontend/build-adapters.js",
    "build-theme-light": "POSTCSS_DISABLE_CACHE=true postcss -o bookmarks/static/theme-light.css bookmarks/styles/theme-light.css",
    "build-theme-dark": "POSTCSS_DISABLE_CACHE=true postcss -o bookmarks/static/theme-dark.css bookmarks/styles/theme-dark.css",
    "build-defuddle": "node esbuild.config.mjs",
    "dev": "rollup -c -w",
    "build-site-adapters-css": "POSTCSS_DISABLE_CACHE=true postcss -o site_adapters/static/site-adapters.css site_adapters/styles/site-adapters.css",
    "dev-site-adapters-css": "POSTCSS_DISABLE_CACHE=true postcss -o site_adapters/static/site-adapters.css site_adapters/styles/site-adapters.css -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WooHooDai/linkding-cn.git"
  },
  "keywords": [],
  "author": "WooHooDai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WooHooDai/linkding-cn/issues"
  },
  "homepage": "https://github.com/WooHooDai/linkding-cn#readme",
  "dependencies": {
    "linkedom": "^0.18.13",
    "playwright-core": "^1.62.1",
    "single-file-cli": "2.1.3"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@hotwired/turbo": "^8.0.23",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/wasm-node": "^4.62.2",
    "approx-string-match": "^2.0.0",
    "cssnano": "^8.0.2",
    "defuddle": "^0.19.1",
    "esbuild": "^0.28.1",
    "iconify-icon": "^3.0.2",
    "lit": "^3.3.3",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.9.4",
    "sortablejs": "^1.15.7",
    "terser": "5.44.0"
  },
  "web-types": "./web-types.json",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
