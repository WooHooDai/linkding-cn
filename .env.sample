# linkding-cn environment configuration
#
# Quick start: copy this file to .env, fill in the initial superuser credentials,
# then run docker compose up -d. Recreate the container after changing .env.
# Compose reads .env for interpolation and passes it through service.env_file.
# Local Django commands do not load .env automatically. For example, use:
#   uv run --env-file .env manage.py runserver
#
# Active assignments are limited to the three Compose deployment fields, two
# initial-user placeholders, three UTF-8 locale settings, and LD_BROWSER_ENGINE
# (kept explicit because Python and standalone JS have different fallbacks).
# These are template choices; they are not all required or built-in defaults.
# All other entries are commented so they inherit application/image/tool defaults.
# Uncomment an optional entry only when you want to override its inherited value.
# A commented switch does not disable a feature; its existing/default value applies.
#
# Default means the value used when a variable is UNSET. Explicitly assigning
# today's default pins that value even if a future release changes the default.
# An empty assignment is also an explicit value; it does not generally restore
# the default. Keep optional numeric values, paths, and credentials commented
# until you configure them. Build arguments below are reference-only.
# Examples are illustrative; replace example domains, paths, and credentials.
# Use True/False for application booleans; uWSGI exceptions are documented below.
# Single quotes preserve spaces, JSON, dollar signs, and hash characters in
# Compose/uv dotenv files. Plain docker run --env-file does not strip quotes.
# Container paths refer to the container filesystem, not the Docker host.
#
# Sources: bookmarks/settings/{base,prod}.py, bootstrap.sh, uwsgi.ini,
# docker-compose.yml, docker/*.Dockerfile, and the consumers named below.


# =============================================================================
# 1. Docker Compose deployment
# =============================================================================

# Name assigned to the application container.
# Default: no Compose fallback; this template uses linkding-cn.
# Example: linkding-personal. The legacy installer defaults to linkding.
LD_CONTAINER_NAME=linkding-cn

# Host port published to container port 9090 by docker-compose.yml.
# Default: 9090. Example: 8080, or 127.0.0.1:9090 for a loopback-only binding.
LD_HOST_PORT=9090

# Host directory mounted at /etc/linkding/data for persistent application data.
# Default: ./data in Compose; /etc/linkding/data in the legacy installer.
# Example: /srv/linkding/data. Relative Compose paths use the Compose directory.
LD_HOST_DATA_DIR=./data

# Address on which the Docker bootstrap script starts the uWSGI HTTP server.
# Default: [::] (all IPv6 interfaces, usually also IPv4). Example: 0.0.0.0.
# LD_SERVER_HOST=[::]

# HTTP listening port inside the container; also used by its healthcheck.
# Default: 9090. Example: 8080.
# If changed, also update the container side of the Compose ports mapping,
# which is fixed at 9090 in the supplied docker-compose.yml.
# LD_SERVER_PORT=9090


# =============================================================================
# 2. Application URL, sessions, and time zone
# =============================================================================

# URL prefix when serving the application below a subpath.
# Default: empty (serve at /). Example: linkding/.
# A nonempty prefix must have a trailing slash and no leading slash.
# LD_CONTEXT_PATH=

# Single allowed request hostname, read only by production settings.
# Default: unset/empty (allow all hosts). Example: bookmarks.example.com.
# Use a hostname without a scheme, port, or path; this is not a list.
# When restricting the host, configure the Docker healthcheck's Host header too.
# HOST_NAME=bookmarks.example.com

# Lifetime of an authenticated session cookie, in seconds.
# Default: 1209600 (14 days). Example: 86400 (1 day).
# LD_SESSION_COOKIE_AGE=1209600

# IANA time zone for Django and local-time background schedules.
# Default: Asia/Shanghai. Example: UTC or Europe/Berlin.
TZ=Asia/Shanghai

# Skip bookmark URL validation when True.
# Default: False (validate URLs). Example: True for otherwise rejected URLs.
# LD_DISABLE_URL_VALIDATION=False


# =============================================================================
# 3. Initial administrator and password login
# =============================================================================
# bootstrap.sh runs create_initial_superuser on startup. These values only
# create a missing user; changing them does not update an existing account.

# Username of the initial administrator.
# Default: unset/empty (do not create a user). Example: admin.
LD_SUPERUSER_NAME=

# Password assigned to the newly created administrator.
# Default: unset/empty (create that user with an unusable password).
# Example: 'replace-with-a-long-unique-password'. Set this for password login;
# an unusable password requires another authentication method for that account.
LD_SUPERUSER_PASSWORD=

# Hide the password login form, for example when enforcing OIDC authentication.
# Default: False. Example: True after configuring another login method.
LD_DISABLE_LOGIN_FORM=False


# =============================================================================
# 4. Authentication proxies and reverse proxies
# =============================================================================

# Authenticate users through a trusted proxy, such as Authelia.
# Default: False. Example: True.
# The proxy must set/sanitize the identity header and prevent direct access.
# Enabling this replaces the normal authentication backends with RemoteUserBackend,
# including the OIDC backend if both features are enabled.
# LD_ENABLE_AUTH_PROXY=False

# Django request.META key containing the authenticated username.
# Default: REMOTE_USER. Example: HTTP_REMOTE_USER for the Remote-User HTTP header.
# HTTP headers normally use an HTTP_ prefix, uppercase letters, and underscores.
# LD_AUTH_PROXY_USERNAME_HEADER=REMOTE_USER

# Redirect destination after logout when authentication proxy support is enabled.
# Default: unset/empty (the normal login URL). Example: https://auth.example.com/logout.
# LD_AUTH_PROXY_LOGOUT_URL=https://auth.example.com/logout

# Use X-Forwarded-Host to determine the original host behind a trusted proxy.
# Default: False. Example: True when the proxy supplies the original host.
# LD_USE_X_FORWARDED_HOST=False

# Additional trusted origins for CSRF-protected requests.
# Default: unset/empty (no additional origins in base/production settings).
# Example: https://bookmarks.example.com,https://links.example.com
# Use comma-separated origins, including schemes and optional ports, without
# spaces or paths. Development settings separately trust https://*.ngrok-free.app.
# LD_CSRF_TRUSTED_ORIGINS=


# =============================================================================
# 5. OpenID Connect (OIDC)
# =============================================================================
# The OIDC_* entries are read only when LD_ENABLE_OIDC=True. Configure endpoints
# and client credentials for your provider. Register the application's callback
# URL, such as https://bookmarks.example.com/oidc/callback/; include LD_CONTEXT_PATH
# in that URL when serving under a subpath.

# Enable the OIDC login flow and authentication backend.
# Default: False. Example: True.
# LD_ENABLE_OIDC=False

# Provider endpoint to which users are sent to authorize a login.
# Default: unset; required for OIDC. Example: the Keycloak URL below.
# OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.example.com/realms/linkding/protocol/openid-connect/auth

# Provider endpoint used to exchange the authorization code for tokens.
# Default: unset; required for OIDC. Example: the Keycloak URL below.
# OIDC_OP_TOKEN_ENDPOINT=https://auth.example.com/realms/linkding/protocol/openid-connect/token

# Provider endpoint used to retrieve the authenticated user's claims.
# Default: unset; required for OIDC. Example: the Keycloak URL below.
# OIDC_OP_USER_ENDPOINT=https://auth.example.com/realms/linkding/protocol/openid-connect/userinfo

# Provider JSON Web Key Set endpoint for validating signed tokens.
# Default: unset; configure for asymmetric signing such as the default RS256.
# Example: the Keycloak URL below.
# OIDC_OP_JWKS_ENDPOINT=https://auth.example.com/realms/linkding/protocol/openid-connect/certs

# Client identifier registered with the identity provider.
# Default: unset; required for OIDC. Example: linkding.
# OIDC_RP_CLIENT_ID=linkding

# Client secret issued by the identity provider.
# Default: unset; required when the provider uses a confidential client.
# Example: 'replace-with-your-oidc-client-secret'.
# OIDC_RP_CLIENT_SECRET='replace-with-your-oidc-client-secret'

# Expected signing algorithm for the provider's ID tokens.
# Default: RS256. Example: RS256; match your provider's signing configuration.
# OIDC_RP_SIGN_ALGO=RS256

# Space-separated scopes requested during authentication.
# Default: openid email profile. Example: 'openid email profile groups'.
# OIDC_RP_SCOPES='openid email profile'

# Enable Proof Key for Code Exchange (PKCE) for the authorization code flow.
# Default: True. Example: False only for a provider that cannot support PKCE.
# OIDC_USE_PKCE=True

# Verify TLS certificates when contacting the OIDC provider.
# Default: True. Example: True with a publicly trusted provider certificate.
# OIDC_VERIFY_SSL=True

# Claim used to derive the local username; missing/empty claims fall back to email.
# Default: email. Example: preferred_username.
# OIDC_USERNAME_CLAIM=email


# =============================================================================
# 6. Database
# =============================================================================
# SQLite requires no server and stores its database in data/db.sqlite3.
# PostgreSQL requires an existing database and the PostgreSQL Python driver
# (included in the Docker images). The LD_DB_DATABASE/USER/PASSWORD/HOST/PORT
# entries below only configure PostgreSQL. LD_DB_OPTIONS applies to both engines.
# Empty database names, users, and hosts override the defaults; leave these
# entries commented out to use the documented fallback values.

# Database backend: sqlite or postgres.
# Default: sqlite. Example: postgres.
LD_DB_ENGINE=sqlite

# PostgreSQL database name; does not change the SQLite database filename.
# Default: linkding. Example: linkding_production.
# LD_DB_DATABASE=linkding

# PostgreSQL role used to authenticate the connection.
# Default: linkding. Example: linkding_app.
LD_DB_USER=linkding

# PostgreSQL password for LD_DB_USER.
# Default: unset (no password supplied by the application).
# Example: 'replace-with-your-database-password'.
LD_DB_PASSWORD='replace-with-your-database-password'

# PostgreSQL server hostname or socket directory.
# Default: localhost. Example: postgres (a Compose database service name).
# Inside a container, localhost refers to that container, not the Docker host.
# LD_DB_HOST=localhost

# PostgreSQL server port.
# Default: unset (the driver default, normally 5432). Example: 5433.
# LD_DB_PORT=5432

# JSON object passed to Django's database backend as connection options.
# Default: {} (also used for an empty value).
# Example for SQLite: '{"timeout":20}'
# Example for PostgreSQL: '{"sslmode":"require","connect_timeout":10}'
# LD_DB_OPTIONS='{}'


# =============================================================================
# 7. Background processing and assets
# =============================================================================

# Disable background processing for metadata, favicons, previews, and snapshots.
# Default: False. Example: True to disable background work.
# Use exactly True to also stop bootstrap.sh from starting the worker;
# Django additionally recognizes true and 1, but the shell check does not.
# LD_DISABLE_BACKGROUND_TASKS=False

# Enable snapshot creation; also requires background tasks and snapshot tooling.
# Default: True in Django and Debian Plus; False in Debian/Alpine Base images.
# Example: False to disable snapshots. Leave commented to keep the image default.
# Setting True on a Base image does not install the missing browser dependencies.
# LD_ENABLE_SNAPSHOTS=True

# Disable manual asset uploads.
# Default: False (uploads enabled). Example: True.
# LD_DISABLE_ASSET_UPLOAD=False

# Minimum spacing between metadata requests to the same registrable domain,
# in seconds. The limiter is local to each process, not shared between workers.
# Default: 0 (no extra delay). Example: 2. Use a nonnegative integer.
# LD_METADATA_DOMAIN_COOLDOWN_SEC=0


# =============================================================================
# 8. Favicons, quick-tag icons, and preview images
# =============================================================================

# Favicon provider URL templates, separated by |. Supports {domain} and {url}.
# Default: unset/empty uses both of these built-in providers:
#   https://twenty-icons.com/{domain}/32
#   https://t1.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url={url}&size=32
# Example: 'https://icons.example.com/{domain}|https://fallback.example.com/?url={url}'
# LD_FAVICON_PROVIDER=

# Allow manual and scheduled favicon refreshes.
# Default: True. Example: False to disable refresh while retaining initial loads.
LD_ENABLE_REFRESH_FAVICONS=True

# Five-field cron schedule for favicon refresh: minute hour day month weekday.
# Uses TZ. Empty or off disables scheduled refresh; manual refresh still follows
# LD_ENABLE_REFRESH_FAVICONS and the background-task/user preference switches.
# Default: '0 0 */7 * *' (midnight on days 1, 8, 15, 22, and 29 when present).
# Example: '0 3 * * *' for daily refresh at 03:00, or off to disable.
LD_FAVICON_REFRESH_SCHEDULE='0 0 */7 * *'

# Comma-separated Iconify names offered as preset quick-tag icons.
# Default: unset/empty uses the following built-in list:
#   tabler:tags,tabler:folder,tabler:bookmark,tabler:star,tabler:heart,
#   tabler:flag,tabler:pin,tabler:clock,tabler:bolt,tabler:flame,tabler:leaf,
#   tabler:world,tabler:code,tabler:camera,tabler:music,tabler:tool,
#   tabler:palette,tabler:mood-happy
# Example: tabler:tags,tabler:folder,tabler:star
# LD_PRESET_ICON_NAMES=

# Maximum downloaded preview-image size, in bytes.
# Default: 5242880 (5 MiB). Example: 10485760 (10 MiB).
# LD_PREVIEW_MAX_SIZE=5242880


# =============================================================================
# 9. Browser engine and SingleFile HTML snapshots
# =============================================================================

# Browser engine: chromium or cloakbrowser.
# Default: chromium in Django and Debian Plus. Example: cloakbrowser.
# Standalone JS helpers fall back to cloakbrowser when this is unset, so this
# template sets chromium explicitly to keep Python and JS consumers consistent.
# CloakBrowser requires a separate installation; it is not in the shipped images.
LD_BROWSER_ENGINE=chromium

# Chromium executable path used by browser adapters and cookie refresh helpers.
# Default: unset/empty (discover an installed browser). Example: /usr/bin/chromium.
# SingleFile can be configured separately with --browser-executable-path in
# LD_SINGLEFILE_OPTIONS. A Django LD_BROWSER_CHROMIUM_PATH setting takes priority
# over this variable for Python browser discovery and cookie refresh.
# CHROMIUM_PATH=/usr/bin/chromium

# Optional CloakBrowser license key, read by settings and JS browser helpers.
# Default: unset/empty (no project-provided license). Example: 'your-license-key'.
# Cookie refresh instead forwards the Django LD_BROWSER_CLOAKBROWSER_LICENSE_KEY
# setting; see the settings-only notes at the end of this file.
# CLOAKBROWSER_LICENSE_KEY='your-license-key'

# SingleFile CLI executable name or path.
# Default: single-file (resolved through PATH).
# Example: /opt/node-runtime/node_modules/.bin/single-file in Docker.
# LD_SINGLEFILE_PATH=single-file

# Global SingleFile command-line arguments, parsed with shell-style quoting.
# Default: empty. Example: '--browser-executable-path=/usr/bin/chromium'.
# Overrides base/uBlock options; adapter-injected options and singlefile_args
# take precedence. Repeatable arguments, such as --browser-arg, accumulate.
# LD_SINGLEFILE_OPTIONS=

# Base browser launch arguments for the bundled uBlock Origin Lite extension.
# Default: the four arguments shown below. An empty value removes these arguments.
# Example without the extension: '--browser-arg=--headless=new --browser-arg=--no-sandbox'.
# LD_SINGLEFILE_UBLOCK_OPTIONS='--browser-arg=--headless=new --browser-arg=--user-data-dir=chromium-profile --browser-arg=--no-sandbox --browser-arg=--load-extension=uBOLite.chromium.mv3'

# Fallback maximum duration of a SingleFile process, in seconds (float accepted).
# Default: 120. Example: 180. A nonzero adapter timeout takes precedence.
# LD_SINGLEFILE_TIMEOUT_SEC=120


# =============================================================================
# 10. Snapshot downloads, scheduling, and retries
# =============================================================================

# Maximum size of a directly downloaded PDF snapshot, in bytes.
# Default: 15728640 (15 MiB). Example: 31457280 (30 MiB).
# LD_SNAPSHOT_PDF_MAX_SIZE=15728640

# Comma-separated retry delays in seconds; each entry permits one retry.
# Default: 60,300,1500 (three retries after 1, 5, and 25 minutes).
# Example: 120,600. An empty value disables retries. Use integer delays;
# at least 30 seconds is recommended to allow browser startup and avoid bursts.
# Domain cooldowns can delay retries; when the dispatcher loop has exited, the
# periodic fallback can add up to a minute before processing resumes.
# LD_SNAPSHOT_RETRY_DELAYS=60,300,1500

# Lower bound for randomized spacing between snapshots of the same domain.
# Default: 5 seconds. Example: 10. Use a nonnegative integer.
# LD_SNAPSHOT_DOMAIN_COOLDOWN_MIN_SEC=5

# Upper bound for randomized spacing between snapshots of the same domain.
# Default: 10 seconds. Example: 20. Use an integer >= the minimum above.
# LD_SNAPSHOT_DOMAIN_COOLDOWN_MAX_SEC=10

# Delay between snapshot dispatcher polling iterations, in seconds.
# Default: 1. Example: 2. Values below 1 are clamped to 1.
# LD_SNAPSHOT_DISPATCHER_TICK_SEC=1


# =============================================================================
# 11. Site adapters and outgoing requests
# =============================================================================

# Base directory for site adapter configuration, scripts, credentials, and logs.
# Default: <project-root>/data/site_adapters; /etc/linkding/data/site_adapters in Docker.
# Example: /srv/linkding/site_adapters for a local installation.
# Use a writable, persistent directory. See docs/site-adapters.md for its layout.
# LD_SITE_ADAPTERS_DIR=/etc/linkding/data/site_adapters

# User-Agent supplied to the website loader and Wayback Machine requests.
# Default: empty. Example: 'Mozilla/5.0 (compatible; Linkding/1.0)'.
# Adapter HTTP headers override it for website loading, including the built-in
# User-Agent; Wayback Machine requests use this environment value directly.
# Prefer _builtin_overrides.defaults.http.User-Agent in
# <LD_SITE_ADAPTERS_DIR>/adapters/defaults/adapters.jsonc for a global override.
# LD_DEFAULT_USER_AGENT=

# Standard proxy variables below are honored by HTTP clients such as Requests;
# they do not configure every browser or subprocess. For browser snapshots,
# configure the site adapter proxy or SingleFile arguments as appropriate.
# Lowercase http_proxy, https_proxy, all_proxy, and no_proxy are also recognized
# by compatible clients; keep uppercase/lowercase values consistent.

# Proxy used for outgoing HTTP requests by compatible clients.
# Default: unset (no proxy configured here). Example: http://proxy.example.com:3128.
# HTTP_PROXY=http://proxy.example.com:3128

# Proxy used for outgoing HTTPS requests; the proxy URL can itself use http://.
# Default: unset (no proxy configured here). Example: http://proxy.example.com:3128.
# HTTPS_PROXY=http://proxy.example.com:3128

# Fallback proxy for protocols without a more specific proxy setting.
# Default: unset. Example: http://proxy.example.com:3128.
# ALL_PROXY=http://proxy.example.com:3128

# Comma-separated hosts or address ranges that should bypass HTTP client proxies.
# Default: unset (no exclusions configured here). Example: localhost,127.0.0.1,::1,.example.com.
# NO_PROXY=localhost,127.0.0.1,::1


# =============================================================================
# 12. uWSGI request handling (Docker production server)
# =============================================================================
# These variables are consumed by uwsgi.ini, not by Django's development server.

# Set the HTTP/socket timeouts and worker request lifetime (harakiri), in seconds.
# Default: unset (uWSGI defaults; no project-configured harakiri limit).
# Example: 120. Use a positive integer to enable all three limits together.
# LD_REQUEST_TIMEOUT=120

# Maximum HTTP request body size enforced by uWSGI, in bytes.
# Default: unset (no uWSGI body-size limit); application/proxy limits still apply.
# Example: 104857600 (100 MiB).
# LD_REQUEST_MAX_CONTENT_LENGTH=104857600

# Log the client IP from X-Forwarded-For instead of REMOTE_ADDR.
# Default: unset (disabled). Example: 1 behind a trusted proxy.
# Set True or 1 to enable. False, off, no (case-insensitive), and 0 disable it;
# leaving it unset also keeps it disabled. These are uWSGI boolean rules.
# LD_LOG_X_FORWARDED_FOR=1

# Suppress normal request logs while retaining HTTP 4xx and 5xx request logs.
# Default: unset (log requests). Example: true.
# uwsgi.ini requires the exact lowercase value true to enable this option.
# LD_DISABLE_REQUEST_LOGS=true

# Maximum file descriptors requested by uWSGI, via its UWSGI_* option support.
# Default: 4096 in the Docker images; otherwise inherited from uWSGI/the OS.
# Example: 8192, subject to the process resource limit.
# UWSGI_MAX_FD=4096


# =============================================================================
# 13. Locale and container runtime
# =============================================================================

# Base locale for native tools, including non-ASCII filenames.
# Default: inherited from the OS/image; this template uses C.UTF-8.
# Example: C.UTF-8, or another UTF-8 locale installed on the target system.
LANG=C.UTF-8

# Override all locale categories, taking precedence over LANG.
# Default: unset (inherit individual locale categories/LANG).
# Example: C.UTF-8; retained here for consistent Chinese/non-ASCII file handling.
LC_ALL=C.UTF-8

# Encoding for Python standard input/output/error streams.
# Default: Python's locale/UTF-8-mode defaults. Example: utf-8.
PYTHONIOENCODING=utf-8

# Node.js module search directory for runtime JavaScript helpers.
# Default: /opt/node-runtime/node_modules in Docker; unset for local development.
# Example: /opt/node-runtime/node_modules. Local installs use npm-installed modules.
# NODE_PATH=/opt/node-runtime/node_modules

# Node.js executable used by Python Playwright's driver.
# Default: /usr/local/bin/node in Docker; Playwright's bundled Node outside Docker.
# Example: /usr/local/bin/node. The Docker browser layer removes the bundled copy.
# PLAYWRIGHT_NODEJS_PATH=/usr/local/bin/node

# Writable configuration directory used by Chromium and other XDG-aware tools.
# Default: /tmp/.chromium in Debian Plus; otherwise the tool/platform default.
# Example: /tmp/.chromium.
# XDG_CONFIG_HOME=/tmp/.chromium

# Writable cache directory used by Chromium and other XDG-aware tools.
# Default: /tmp/.chromium in Debian Plus; otherwise the tool/platform default.
# Example: /tmp/.chromium.
# XDG_CACHE_HOME=/tmp/.chromium

# Virtual environment selected by the container image or local Python tooling.
# Default: /etc/linkding/.venv in Docker; selected by uv/activation locally.
# Example: /etc/linkding/.venv. Normally keep the value supplied by the image/tool.
# VIRTUAL_ENV=/etc/linkding/.venv

# Executable lookup path, including Python, Node, and the SingleFile CLI.
# Default: Docker prepends /etc/linkding/.venv/bin and
# /opt/node-runtime/node_modules/.bin to the base image's PATH.
# Example: the minimal container path below; normally retain the inherited PATH.
# PATH=/etc/linkding/.venv/bin:/opt/node-runtime/node_modules/.bin:/usr/local/bin:/usr/bin:/bin

# Supervisor explicitly sets HOME=/tmp/home for background workers so Chromium
# has a writable home. It is managed in supervisord.conf, not through .env.


# =============================================================================
# 14. Local development and frontend builds
# =============================================================================
# Export these for the relevant command, or use uv run --env-file .env ... .
# npm and the Docker build script do not load this file themselves.

# Django settings module to import for management commands or a server.
# Default: bookmarks.settings (dev when available, otherwise prod).
# uWSGI explicitly selects bookmarks.settings.prod in uwsgi.ini.
# pytest.ini selects bookmarks.settings.test for the test suite.
# Example: bookmarks.settings.prod or bookmarks.settings.test.
# DJANGO_SETTINGS_MODULE=bookmarks.settings

# Disable Python .pyc file generation when nonempty.
# Default: unset at runtime; 1 in the Docker app-build stage.
# Example: 1 for a local command that should not write bytecode caches.
# PYTHONDONTWRITEBYTECODE=1

# Node ecosystem build mode; Docker sets this for npm run build.
# Default: unset locally; production in the Docker frontend build stage.
# Example: production. Rollup minification is controlled by ROLLUP_WATCH below.
# NODE_ENV=production

# Tell rollup.config.mjs to skip production minification when nonempty.
# Default: unset for a normal build; Rollup sets true in watch mode (npm run dev).
# Example: true. Even the string false is nonempty and skips minification.
# Setting this variable alone does not start watch mode.
# ROLLUP_WATCH=true

# Compatibility cache flag supplied by the project's PostCSS build commands.
# Default: true in package.json/Docker builds; unset for other commands.
# Example: true. postcss.config.js also configures cache: false explicitly.
# POSTCSS_DISABLE_CACHE=true


# =============================================================================
# 15. Legacy Monolith implementation
# =============================================================================
# The normal snapshot pipeline uses SingleFile. These settings are retained for
# bookmarks/services/monolith.py and do not select Monolith as the active engine.

# Monolith executable name or path for callers of the legacy service.
# Default: monolith (resolved through PATH). Example: /usr/local/bin/monolith.
# LD_MONOLITH_PATH=monolith

# Monolith command-line arguments, parsed with shell-style quoting.
# Default: '-a -v -s'. Example: '-a -v' to use Monolith's default script handling.
# LD_MONOLITH_OPTIONS='-a -v -s'


# =============================================================================
# 16. Docker build argument reference (not runtime environment settings)
# =============================================================================
# Setting these in .env does not change an existing image or automatically pass
# them to a build. Supply --build-arg NAME=value to Docker Buildx explicitly.
# scripts/build-docker.sh accepts extra Buildx options after --, for example:
#   scripts/build-docker.sh --load -- --build-arg SQLITE_RELEASE=3430000
# See docs/docker-images.md for variants, pinned dependencies, and verification.

# Python base image, matched to the Debian or Alpine Dockerfile.
# Default: digest-pinned python:3.13.7-slim-bookworm (Debian) or
# python:3.13.7-alpine3.21 (Alpine); exact digests are in docker/*.Dockerfile.
# Example: python:3.13.7-slim-bookworm for a Debian build.
# PYTHON_IMAGE=python:3.13.7-slim-bookworm

# Node.js image supplying frontend build tools and native runtime binaries.
# Default: digest-pinned node:24.20.0-bookworm-slim (Debian) or
# node:24.20.0-alpine3.23 (Alpine); exact digests are in docker/*.Dockerfile.
# Example: node:24.20.0-bookworm-slim for a Debian build.
# NODE_IMAGE=node:24.20.0-bookworm-slim

# Hostname replacing deb.debian.org during Debian package installation.
# Default: empty in the Dockerfile; the build script supplies the Tsinghua mirror
# unless --no-mirror is passed. Example: mirrors.tuna.tsinghua.edu.cn (no scheme).
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# Hostname replacing dl-cdn.alpinelinux.org during Alpine package installation.
# Default: empty in the Dockerfile; the build script supplies the Tsinghua mirror
# unless --no-mirror is passed. Example: mirrors.tuna.tsinghua.edu.cn (no scheme).
# APK_MIRROR=mirrors.tuna.tsinghua.edu.cn

# SQLite download release year used when compiling the ICU extension.
# Default: 2023. Example: 2023 paired with SQLITE_RELEASE=3430000.
# SQLITE_RELEASE_YEAR=2023

# SQLite amalgamation release number used when compiling the ICU extension.
# Default: 3430000 (3.43.0). Example: 3430000; keep the release year in sync.
# SQLITE_RELEASE=3430000

# Chromium package version installed by the Debian Plus build stage.
# Default: 152.0.7977.82-1~deb12u1. Example: that same version while available.
# Change to an available Debian version deliberately and run browser verification.
# CHROMIUM_VERSION=152.0.7977.82-1~deb12u1

# Application version recorded in the OCI image label.
# Default: dev for direct Docker builds; scripts/build-docker.sh reads version.txt.
# Example: 1.2.0. Setting this does not rewrite the application's version.txt.
# VERSION=dev

# Source revision recorded in the OCI image label.
# Default: unknown for direct Docker builds; the build script supplies Git HEAD
# with a -dirty suffix when tracked files differ. Example: a full Git commit SHA.
# REVISION=unknown

# BUILDPLATFORM and TARGETARCH are populated by BuildKit, not by this .env file.
# BUILDPLATFORM identifies the native builder (example: linux/arm64).
# TARGETARCH identifies the selected target architecture (example: amd64).


# =============================================================================
# Configuration boundaries
# =============================================================================
# Only settings explicitly read from the environment are environment options.
# The following names are currently Django settings ONLY; set them in
# bookmarks/settings/custom.py (or a mounted replacement), not as .env entries:
#   LD_SITE_ADAPTERS_LOG_RETENTION_DAYS: execution log retention; default 30 days.
#   LD_BROWSER_CHROMIUM_PATH: explicit browser path; default empty.
#     CHROMIUM_PATH above is the supported environment alternative.
#   LD_BROWSER_CLOAKBROWSER_LICENSE_KEY: Python browser/cookie-refresh license;
#     default empty. CLOAKBROWSER_LICENSE_KEY is a separate environment input.
#   LD_BROWSER_CLOAKBROWSER_LICENSE_TYPE: browser configuration label; default free.
# The production Django secret key is stored in data/secretkey.txt and generated
# by bootstrap.sh; there is no project environment variable for SECRET_KEY.
#
# CI sets BUILD_FLAGS from its variant matrix (default empty; example --base),
# and BASELINE_PLUS/BASELINE_BASE/BASELINE_ALPINE from workflow inputs for image
# size checks (defaults: woohoodai/linkding-cn:latest / empty / empty; examples:
# woohoodai/linkding-cn:latest-plus / :latest-base / :latest-base-alpine).
# These workflow values are not read from .env. Release credentials belong in
# the GitHub Actions variable DOCKERHUB_USERNAME and secret DOCKERHUB_TOKEN.
# These have no defaults; provide your Docker Hub username and an access token.
#
# The PostgreSQL helper scripts set POSTGRES_DB, POSTGRES_USER, and
# POSTGRES_PASSWORD on a separate database container (all set to linkding for
# those local tests). These select its initial database, role, and password;
# a deployment example would use linkding, linkding_app, and a unique password.
# Configure the application's connection through LD_DB_* above. The supplied
# docker-compose.yml does not define a PostgreSQL service or pass POSTGRES_*.
